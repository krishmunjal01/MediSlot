# ==============================================================
# MediSlot Configuration Template (Copy to application.properties)
# ==============================================================
server.port=8080
spring.application.name=medislot

# Configure your MySQL 8 instance here
spring.datasource.url=jdbc:mysql://localhost:3306/medislot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# HikariCP Pool
spring.datasource.hikari.maximum-pool-size=15
spring.datasource.hikari.minimum-idle=5

# Thymeleaf
spring.thymeleaf.cache=false
spring.thymeleaf.mode=HTML
spring.thymeleaf.encoding=UTF-8

